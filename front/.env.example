# Portal de levantamientos. Copia este archivo a .env.local y llénalo.

# Firma de la cookie altitud_portal. Genera uno con: openssl rand -hex 32
AUTH_SECRET=

# true solo detrás de HTTPS
COOKIE_SECURE=

# Conexión a Odoo. El compose de ../odoo publica el puerto 8072.
ODOO_URL=http://localhost:8072
ODOO_DB=altitud

# Cuenta técnica: valida sesiones y hace todas las lecturas y escrituras.
# ODOO_API_KEY tiene prioridad sobre ODOO_PASSWORD.
ODOO_USER=
ODOO_API_KEY=
ODOO_PASSWORD=

# Orígenes extra permitidos en `next dev` (separados por coma).
ALLOWED_DEV_ORIGINS=
