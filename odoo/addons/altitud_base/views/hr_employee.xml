<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_altitud" model="ir.ui.view">
        <field name="name">hr.employee.form.altitud</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Telegram" name="altitud_telegram">
                    <field name="x_telegram_chat_id" placeholder="Identificador del chat"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
